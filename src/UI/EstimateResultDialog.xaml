<Window x:Class="EstimatingTools.UI.EstimateResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EstimatingTools.UI"
        Title="Estimate"
        Width="600" SizeToContent="Height"
        MinHeight="280" MaxHeight="820"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Everything but the section list is docked, so at MaxHeight only
         the section cards scroll and the pinned total stays visible. -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OpenButton" Style="{StaticResource PrimaryButton}"
                    Click="Open_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Style="{StaticResource SecondaryButton}"
                    Click="Close_Click"/>
        </StackPanel>

        <TextBlock x:Name="PathText" DockPanel.Dock="Bottom" Margin="2,6,0,0"
                   FontSize="11" Foreground="#666666"
                   TextWrapping="Wrap"/>

        <TextBlock x:Name="WarningText" DockPanel.Dock="Bottom" Margin="2,4,0,0"
                   FontSize="11" Foreground="#8A5A00"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <TextBlock x:Name="FootText" DockPanel.Dock="Bottom" Margin="2,0,0,0"
                   FontSize="11" Foreground="#57636E"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <local:EstimateCardView x:Name="TotalCard" DockPanel.Dock="Bottom"
                                Margin="0,4,0,0" Visibility="Collapsed"/>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#2D6B9E" Margin="0,0,0,8"/>
            <TextBlock x:Name="InfoText" FontSize="11" Foreground="#57636E"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Grid>
            <ScrollViewer x:Name="CardScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <ItemsControl x:Name="SectionCards" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:EstimateCardView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Plain-text mode (logs): monospaced so padded columns line up. -->
            <Border x:Name="TextBody" Background="White" BorderBrush="#DDDDDD"
                    BorderThickness="1" CornerRadius="3" Padding="12,8"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              MaxHeight="480">
                    <TextBox x:Name="BodyText"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
