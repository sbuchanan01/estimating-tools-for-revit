<Window x:Class="EstimatingTools.UI.PricingSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pricing Setup"
        Width="740" Height="860"
        MinWidth="640" MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D6B9E"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">

        <!-- ═══ BUTTONS (docked bottom so the scrollable section above never hides them) ═══ -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="SaveButton" Content="Save"
                    Click="Save_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel Margin="0,0,4,0">

        <TextBlock FontSize="13" TextWrapping="Wrap">
            Configure where Pricing Sync reads M / E / F rates from, set labor rates,
            and map them to Revit project parameters. Sources can be active
            simultaneously — Pricing Sync chains the Fab Database first,
            then CSV files in list order, and uses the first non-null value
            found for each rate field.
        </TextBlock>

        <!-- ═══ FAB DATABASE ═══ -->
        <CheckBox x:Name="UseFabDbCheck" Margin="0,16,0,4"
                  Content="Use Fab Database (material + labor rates)"
                  Checked="Source_Changed" Unchecked="Source_Changed"/>

        <Border Margin="22,4,0,0" Padding="8,5" Background="#F8F8F8"
                BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666">
                <Run FontWeight="SemiBold">M-Rate sources:</Run>
                <Run FontFamily="Consolas">supplier.map</Run> for pipe/valve/fitting
                list prices;
                <Run FontFamily="Consolas">Material.MAP</Run> for sheet-metal duct
                (weight × $/lb keyed by material + gauge).
                <LineBreak/>
                <Run FontWeight="SemiBold">Labor sources:</Run>
                <Run FontFamily="Consolas">etimes.map</Run> / <Run FontFamily="Consolas">ftimes.map</Run>
                breakpoint tables for time; per-part install/fab tables from
                <Run FontFamily="Consolas">.ITM</Run> brackets.
                <Run FontFamily="Consolas">cost.map</Run> labor types populate the
                dropdowns below — the $/hr rate is user-editable.
            </TextBlock>
        </Border>

        <Grid Margin="22,8,0,0" IsEnabled="{Binding IsChecked, ElementName=UseFabDbCheck}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderPathBox" IsReadOnly="True" Padding="4,3"
                     BorderBrush="#BBBBBB"/>
            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                    Style="{StaticResource SecondaryButton}" Click="BrowseFolder_Click"/>
        </Grid>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="22,12,0,4"
                   IsEnabled="{Binding IsChecked, ElementName=UseFabDbCheck}"
                   Text="Labor rates"/>

        <Grid Margin="22,0,0,0" IsEnabled="{Binding IsChecked, ElementName=UseFabDbCheck}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Labor type"
                       FontSize="11" Foreground="#777777" Margin="0,0,0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="$/hr"
                       FontSize="11" Foreground="#777777" Margin="0,0,0,2"
                       HorizontalAlignment="Right"/>

            <!-- Installation -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Installation:"
                       VerticalAlignment="Center" Foreground="#444444" Margin="0,0,0,6"/>
            <ComboBox  Grid.Row="1" Grid.Column="1"
                       x:Name="ErectionLabourCombo"
                       IsEditable="True" Padding="4,3" Margin="0,0,0,6"
                       DisplayMemberPath="Display"
                       SelectionChanged="ErectionLabourCombo_SelectionChanged"
                       ToolTip="Pick a labor type from cost.map, or type a custom name."/>
            <TextBox   Grid.Row="1" Grid.Column="3"
                       x:Name="ErectionRateBox"
                       Padding="4,3" Margin="0,0,0,6"
                       BorderBrush="#BBBBBB" HorizontalContentAlignment="Right"
                       ToolTip="Hourly rate applied to all etimes-derived minutes (M-Rate side)."/>

            <!-- Fabrication -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fabrication:"
                       VerticalAlignment="Center" Foreground="#444444" Margin="0,0,0,6"/>
            <ComboBox  Grid.Row="2" Grid.Column="1"
                       x:Name="FabricationLabourCombo"
                       IsEditable="True" Padding="4,3" Margin="0,0,0,6"
                       DisplayMemberPath="Display"
                       SelectionChanged="FabricationLabourCombo_SelectionChanged"
                       ToolTip="Pick a labor type from cost.map, or type a custom name."/>
            <TextBox   Grid.Row="2" Grid.Column="3"
                       x:Name="FabricationRateBox"
                       Padding="4,3" Margin="0,0,0,6"
                       BorderBrush="#BBBBBB" HorizontalContentAlignment="Right"
                       ToolTip="Hourly rate applied to all ftimes-derived minutes (F-Rate side)."/>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="4"
                       FontSize="11" Foreground="#666666" TextWrapping="Wrap"
                       Margin="0,0,0,0">
                Picking a labor type from the dropdown pre-fills its rate from
                <Run FontFamily="Consolas">cost.map</Run>. You can override the rate
                or type a custom name — your edits are what Pricing Sync uses.
            </TextBlock>
        </Grid>

        <CheckBox x:Name="IncludeLooseAncillariesCheck" Margin="22,12,0,0"
                  Content="Include Loose ancillaries (e.g. body-level sealants)"
                  ToolTip="Off (default) matches Fab ESTmep's Cost Breakdown on pipe parts: Loose-scoped ancillaries (Class A duct sealants, etc.) are spec-tracked but not billed. Turn on for duct-heavy projects where Fab DOES bill the sealant."/>

        <!-- ═══ CSV FILES ═══ -->
        <CheckBox x:Name="UseCsvCheck" Margin="0,16,0,4"
                  Content="Use CSV file(s)"
                  Checked="Source_Changed" Unchecked="Source_Changed"/>

        <Grid Margin="22,4,0,0" IsEnabled="{Binding IsChecked, ElementName=UseCsvCheck}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="#BBBBBB" BorderThickness="1" Background="White">
                <ListBox x:Name="CsvList" Height="70"
                         BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Extended"/>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Add Files…" Click="AddCsv_Click"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Content="Remove Selected" Click="RemoveCsv_Click"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <Border Margin="22,6,0,0" Padding="8,5" Background="#F8F8F8"
                BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666">
                <Run FontWeight="SemiBold">CSV format:</Run>
                <LineBreak/>
                Header row required with columns
                <Run FontFamily="Consolas">Product Code</Run>,
                <Run FontFamily="Consolas">M-Rate</Run>,
                <Run FontFamily="Consolas">E-Rate</Run>,
                <Run FontFamily="Consolas">F-Rate</Run>.
                Match key is the FabricationPart's
                <Run FontFamily="Consolas">Product Code</Run>. Files are
                evaluated in list order; first non-null value per rate field wins.
                Excel users: save as .csv (UTF-8).
            </TextBlock>
        </Border>

        <!-- ═══ ESTIMATE TEMPLATE ═══ -->
        <Grid Margin="0,20,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,0"
                       VerticalAlignment="Center"
                       Text="Estimate template (optional)"/>
            <Button Grid.Column="1" Content="Learn more…"
                    Style="{StaticResource SecondaryButton}"
                    Padding="10,3" FontSize="11"
                    Click="EstimateTemplateHelp_Click"
                    ToolTip="How the .xlsx template works — placeholders, table anchors, example."/>
        </Grid>

        <Grid Margin="22,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TemplatePathBox" IsReadOnly="True" Padding="4,3"
                     BorderBrush="#BBBBBB"/>
            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BrowseTemplate_Click"/>
            <Button Grid.Column="2" Content="Generate sample…" Margin="6,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="GenerateSampleTemplate_Click"
                    ToolTip="Writes a sample template .xlsx with every supported placeholder + an Instructions sheet."/>
            <Button Grid.Column="3" Content="Clear" Margin="6,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="ClearTemplate_Click"/>
        </Grid>

        <!-- ═══ REVIT PARAMETER MAPPING ═══ -->
        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,4"
                   Text="Revit parameter mapping"/>

        <Border Padding="8,5" Background="#F8F8F8"
                BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666">
                Pricing Sync writes the three computed rates to the project
                parameters chosen below. Target parameters must be type
                <Run FontWeight="SemiBold">Text</Run>,
                <Run FontWeight="SemiBold">Number</Run>, or
                <Run FontWeight="SemiBold">Currency</Run> and bound to the
                MEP Fabrication categories you want priced (Pipework, Hangers,
                Ductwork). Values are written rounded to 2 decimal places.
                Sync will fail loudly if any mapped parameter is missing
                or has the wrong type.
            </TextBlock>
        </Border>

        <!-- Toggle: write E/F as labor hours instead of dollars -->
        <CheckBox x:Name="WriteLaborAsHoursCheck"
                  Margin="22,10,0,0"
                  Content="Write E-Rate + F-Rate as labor hours instead of dollars"
                  ToolTip="When checked, Pricing Sync writes labor hours (dollars ÷ hourly rate) into the E-Rate and F-Rate parameters instead of the dollar cost. M-Rate stays in dollars either way. If a labor rate is 0, that side is skipped with a warning."/>

        <Grid Margin="22,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="M-Rate (Material):"
                       VerticalAlignment="Center" Foreground="#444444" Margin="0,0,0,6"/>
            <ComboBox  Grid.Row="0" Grid.Column="1"
                       x:Name="MaterialParamCombo"
                       Padding="4,3" Margin="0,0,0,6"
                       DisplayMemberPath="Display"
                       SelectedValuePath="Name"
                       ToolTip="Project parameter that receives the M-Rate value (material $)."/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="E-Rate (Install Labor):"
                       VerticalAlignment="Center" Foreground="#444444" Margin="0,0,0,6"/>
            <ComboBox  Grid.Row="1" Grid.Column="1"
                       x:Name="InstallParamCombo"
                       Padding="4,3" Margin="0,0,0,6"
                       DisplayMemberPath="Display"
                       SelectedValuePath="Name"
                       ToolTip="Project parameter that receives the E-Rate value (install labor $)."/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="F-Rate (Fab Labor):"
                       VerticalAlignment="Center" Foreground="#444444" Margin="0,0,0,6"/>
            <ComboBox  Grid.Row="2" Grid.Column="1"
                       x:Name="FabricationParamCombo"
                       Padding="4,3" Margin="0,0,0,6"
                       DisplayMemberPath="Display"
                       SelectedValuePath="Name"
                       ToolTip="Project parameter that receives the F-Rate value (fabrication labor $)."/>
        </Grid>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
