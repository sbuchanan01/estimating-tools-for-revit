<Window x:Class="EstimatingTools.UI.EstimateTemplateHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estimate Template — How it works"
        Width="620" Height="620"
        MinWidth="520" MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="#2D6B9E"/>
            <Setter Property="Margin"     Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="#333333"/>
            <Setter Property="Margin"       Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="#444444"/>
            <Setter Property="Background"   Value="#EEEEEE"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="Margin"       Value="12,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="Close_Click" Width="90"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold"
                           Foreground="#1F2A38"
                           Text="Custom Excel templates for Generate Estimate"/>

                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0">
                    Point at an <Run FontWeight="SemiBold">.xlsx</Run> file and the
                    three Generate Estimate commands (Material, Labor, Material + Labor)
                    will fill it in with your project's numbers. Your template's
                    formatting, currency formats, logos, and column widths are
                    preserved — the tool only replaces
                    <Run FontWeight="SemiBold">placeholder tokens</Run> and expands
                    table anchor rows with your BOM / labor data.
                    <LineBreak/><LineBreak/>
                    Leave the path blank to use the default plain CSV / XLSX output.
                </TextBlock>

                <TextBlock Style="{StaticResource Section}"
                           Text="Scalar placeholders"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Drop any of these into a cell — they get replaced with the corresponding value."/>
                <TextBlock Style="{StaticResource Mono}">
                    {{ProjectName}}  {{Date}}  {{Source}}  {{PartsScanned}}
                    <LineBreak/>
                    {{MaterialTotal}}  {{PipingTotal}}  {{DuctworkTotal}}  {{HangerAncillaryTotal}}
                    <LineBreak/>
                    {{InstallLabor}}  {{FabLabor}}  {{LaborTotal}}  {{GrandTotal}}
                </TextBlock>

                <TextBlock Style="{StaticResource Section}"
                           Text="Material table anchor"/>
                <TextBlock Style="{StaticResource Body}">
                    Put the column-mapping placeholders side-by-side in ONE row.
                    The tool overwrites that row with the first material line and
                    every row below it with the remaining lines.
                </TextBlock>
                <TextBlock Style="{StaticResource Mono}">
                    {{Materials.Category}}  {{Materials.Code}}  {{Materials.Description}}
                    <LineBreak/>
                    {{Materials.Quantity}}  {{Materials.Unit}}  {{Materials.UnitPrice}}  {{Materials.Total}}
                </TextBlock>

                <TextBlock Style="{StaticResource Section}"
                           Text="Labor table anchor"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Same pattern — put the column placeholders side-by-side in a header row."/>
                <TextBlock Style="{StaticResource Mono}">
                    {{Labor.Type}}  {{Labor.Table}}  {{Labor.Minutes}}
                    <LineBreak/>
                    {{Labor.Hours}}  {{Labor.Rate}}  {{Labor.Cost}}
                </TextBlock>

                <TextBlock Style="{StaticResource Section}"
                           Text="Fastest way to get started"/>
                <TextBlock Style="{StaticResource Body}">
                    Click <Run FontWeight="SemiBold">Generate sample…</Run> next
                    to the path box. That writes a working sample template
                    with every supported placeholder + an Instructions sheet
                    you can strip out or use as a starting point.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
