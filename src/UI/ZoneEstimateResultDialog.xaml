<Window x:Class="EstimatingTools.UI.ZoneEstimateResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EstimatingTools.UI"
        Title="Zone Estimate"
        Width="600" SizeToContent="Height"
        MinHeight="320" MaxHeight="820"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Everything but the zone list is docked, so when the window hits
         MaxHeight only the zone cards scroll and the total stays visible. -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="OpenButton" Content="Open XLSX"
                    Style="{StaticResource PrimaryButton}"
                    Click="Open_Click" Margin="0,0,8,0"/>
            <Button Content="Close"
                    Style="{StaticResource SecondaryButton}"
                    Click="Close_Click"/>
        </StackPanel>

        <TextBlock x:Name="PathText" DockPanel.Dock="Bottom" Margin="2,6,0,0"
                   FontSize="11" Foreground="#666666"
                   TextWrapping="Wrap"/>

        <TextBlock x:Name="FootText" DockPanel.Dock="Bottom" FontSize="11"
                   Foreground="#57636E" Margin="2,0,0,0"/>

        <local:EstimateCardView x:Name="TotalCard" DockPanel.Dock="Bottom"
                                Margin="0,4,0,0"/>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#2D6B9E" Margin="0,0,0,6"
                       Text="Zone Estimate generated"/>

            <CheckBox x:Name="ExcludeUnassignedCheck"
                      Content="Exclude Unassigned Parts"
                      FontSize="12"
                      Margin="0,4,0,10"
                      Checked="ExcludeUnassigned_Changed"
                      Unchecked="ExcludeUnassigned_Changed"/>

            <TextBlock x:Name="InfoText" FontSize="11" Foreground="#57636E"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ZoneCards" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:EstimateCardView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
