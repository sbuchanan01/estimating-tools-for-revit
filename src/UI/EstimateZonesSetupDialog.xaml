<Window x:Class="EstimatingTools.UI.EstimateZonesSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estimate Zones — Setup"
        Width="560" Height="500"
        MinWidth="480" MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="StatusIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" Click="Close_Click" Width="90"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button x:Name="SetupButton" Content="Set up missing pieces"
                    Click="Setup_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Foreground="#1F2A38"
                           Text="Estimate Zones"/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="#57636E" Margin="0,4,0,14">
                    One-time-per-project setup. After this, sketch Areas in the
                    "Estimating Zones" Area Plans, then run Sync Zones to write
                    each Fab part's zone name into the Estimate Zone parameter.
                </TextBlock>

                <TextBlock FontSize="12" FontWeight="SemiBold"
                           Foreground="#2D6B9E"
                           Text="1 · Area Scheme"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBlock x:Name="SchemeIcon" Style="{StaticResource StatusIcon}"/>
                    <TextBlock x:Name="SchemeText" TextWrapping="Wrap"
                               FontSize="12" Foreground="#333333"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="SchemeInstructions"
                           TextWrapping="Wrap"
                           FontSize="11" Foreground="#8A94A0"
                           Margin="22,0,0,12"
                           Visibility="Collapsed"/>

                <TextBlock FontSize="12" FontWeight="SemiBold"
                           Foreground="#2D6B9E"
                           Text="2 · Estimate Zone parameter"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBlock x:Name="ParamIcon" Style="{StaticResource StatusIcon}"/>
                    <TextBlock x:Name="ParamText" TextWrapping="Wrap"
                               FontSize="12" Foreground="#333333"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="ElevParamIcon" Style="{StaticResource StatusIcon}"/>
                    <TextBlock x:Name="ElevParamText" TextWrapping="Wrap"
                               FontSize="12" Foreground="#333333"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock FontSize="12" FontWeight="SemiBold"
                           Foreground="#2D6B9E"
                           Text="3 · Area Plans per Level"/>
                <TextBlock TextWrapping="Wrap" FontSize="11"
                           Foreground="#8A94A0" Margin="0,2,0,4">
                    Each level needs its own Area Plan under the Estimating Zones
                    scheme so you can sketch zones on that level.
                </TextBlock>
                <ItemsControl x:Name="LevelsList" Margin="0,4,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding Icon}"
                                           Style="{StaticResource StatusIcon}"/>
                                <TextBlock Text="{Binding Label}"
                                           FontSize="12" Foreground="#333333"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#F4FAFF" BorderBrush="#B0D4EA"
                        BorderThickness="1" CornerRadius="3"
                        Padding="10,8" Margin="0,4,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="#2D6B9E">
                        <Run FontWeight="SemiBold">After setup:</Run>
                        open one of the Estimating Zones Area Plans in the
                        Project Browser, use Revit's built-in Area tool to
                        sketch each zone, rename each Area to your zone name
                        (Mechanical Room, Zone A, etc.), then run Sync Zones.
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold">Stacked zones (optional):</Run>
                        to split one footprint into vertical bands, set the
                        Area's
                        <Run FontStyle="Italic">Zone Bottom Elevation</Run>
                        and
                        <Run FontStyle="Italic">Zone Top Elevation</Run>
                        (e.g. 0 to 10 ft). Leaving both blank on an Area
                        keeps the classic single-band behavior — the whole
                        level counts as one zone.
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold">Multiple bands, one sketch:</Run>
                        select the Area and run
                        <Run FontStyle="Italic">Estimate Zones → Manage Bands</Run>.
                        Each band becomes its own zone, auto-named from the
                        Area (A-1, A-2, …). Type over a name to override it.
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
