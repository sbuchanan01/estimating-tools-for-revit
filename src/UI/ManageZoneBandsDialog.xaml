<Window x:Class="EstimatingTools.UI.ManageZoneBandsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estimate Zones — Bands"
        Width="560" SizeToContent="Height"
        MinWidth="480" MaxHeight="720"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#57636E"/>
        </Style>
        <Style x:Key="CellBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="90"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click" Width="90"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"
                       Foreground="#1F2A38"/>
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="#57636E" Margin="0,4,0,12">
                Each band is its own zone in Sync Zones and the estimate.
                Names default to the Area name plus a number (A-1, A-2, …);
                type over one to rename it. Elevations are absolute and
                accept feet-inches, e.g. 10'-6".
            </TextBlock>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="1" Text="Zone name" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="2" Text="Bottom" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="3" Text="Top" Style="{StaticResource ColumnHeader}"/>
            </Grid>

            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" FontSize="12"
                       FontStyle="Italic" Foreground="#8A94A0" Margin="0,4,0,4"
                       Text="No bands. The Area covers its whole level. Add a band to split it vertically."/>

            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="BandsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Number}"
                                           FontSize="12" Foreground="#57636E"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource CellBox}">
                                            <Setter Property="Foreground" Value="#333333"/>
                                            <Setter Property="ToolTip" Value="Custom name"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuto}" Value="True">
                                                    <Setter Property="Foreground" Value="#8A94A0"/>
                                                    <Setter Property="ToolTip"
                                                            Value="Auto name, follows the Area name and band order. Type to override."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBox Grid.Column="2" Style="{StaticResource CellBox}"
                                         Text="{Binding BottomText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="3" Style="{StaticResource CellBox}"
                                         Text="{Binding TopText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="4" Content="✕" Click="RemoveBand_Click"
                                        Tag="{Binding}" ToolTip="Remove this band"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="0,3"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Content="+ Add band" Click="AddBand_Click"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    Style="{StaticResource SecondaryButton}"/>

            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12"
                       Foreground="Firebrick" Margin="0,10,0,0"
                       Visibility="Collapsed"/>

            <Border Background="#F4FAFF" BorderBrush="#B0D4EA"
                    BorderThickness="1" CornerRadius="3"
                    Padding="10,8" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#2D6B9E"
                               Text="Level elevations for reference"/>
                    <TextBlock x:Name="LevelsText" TextWrapping="Wrap" FontSize="11"
                               Foreground="#2D6B9E" Margin="0,2,0,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#2D6B9E"
                               Margin="0,6,0,0"
                               Text="Run Sync Zones after saving to re-tag parts."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
