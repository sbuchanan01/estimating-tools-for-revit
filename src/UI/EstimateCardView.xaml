<UserControl x:Class="EstimatingTools.UI.EstimateCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = EstimateCard. -->
    <Border CornerRadius="4" BorderThickness="1"
            BorderBrush="#D5DCE3" Margin="0,0,0,8"
            Background="{Binding BodyBackground}">
        <StackPanel>
            <Border Background="{Binding HeaderBackground}"
                    CornerRadius="3,3,0,0" Padding="12,6">
                <TextBlock Text="{Binding Title}"
                           Foreground="{Binding HeaderForeground}"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}" Margin="12,6,12,8"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                            <Setter Property="BorderBrush" Value="#AAB4BE"/>
                                            <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                            <Setter Property="Margin" Value="0,4,0,0"/>
                                            <Setter Property="Padding" Value="0,5,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="#333B44"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#1F2A38"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Grid.Column="0" Text="{Binding Label}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Amount}"
                                           FontFamily="Consolas"
                                           TextAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
